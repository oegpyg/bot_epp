<!DOCTYPE html>
<html lang="es">

<head>
<meta charset="UTF-8">
<title>Dashboard PRO 6</title>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>

body{
  margin:0;
  font-family:Arial;
  background:#0b1220;
  color:white;
}

.container{
  max-width:1200px;
  margin:auto;
  padding:20px;
}

/* =========================
HEADER
========================= */

.topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:15px;
  margin-bottom:20px;
}

.actions{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
}

.actions a button{
  background:#2563eb;
  color:white;
  border:none;
  padding:10px 15px;
  border-radius:10px;
  cursor:pointer;
  font-weight:bold;
}

/* =========================
BOTON CAMPAÑAS
========================= */

.campBtn{
  background:#22c55e;
  color:white;
  border:none;
  padding:12px 20px;
  border-radius:10px;
  cursor:pointer;
  font-size:16px;
  font-weight:bold;
  transition:.3s;
}

.campBtn:hover{
  transform:scale(1.03);
  opacity:.9;
}

/* =========================
FILTROS
========================= */

.filters{
  display:flex;
  gap:10px;
  margin-bottom:20px;
  flex-wrap:wrap;
}

.filters input{
  padding:10px;
  border:none;
  border-radius:10px;
  background:#111b2e;
  color:white;
}

.filters button{
  background:#22c55e;
  color:white;
  border:none;
  padding:10px 15px;
  border-radius:10px;
  cursor:pointer;
  font-weight:bold;
}

/* =========================
KPIS
========================= */

.kpis{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:15px;
}

.kpi{
  background:#111b2e;
  padding:20px;
  border-radius:15px;
  box-shadow:0 0 20px rgba(0,0,0,.2);
}

.kpi h2{
  margin:0;
  font-size:34px;
}

.kpi p{
  opacity:.7;
}

/* =========================
CHARTS
========================= */

.grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
  margin-top:20px;
}

.box{
  background:#111b2e;
  padding:20px;
  border-radius:15px;
}

/* =========================
ACTIVIDAD
========================= */

.feed{
  margin-top:20px;
  background:#111b2e;
  padding:20px;
  border-radius:15px;
}

.item{
  background:#0f172a;
  padding:12px;
  border-left:4px solid #3b82f6;
  border-radius:10px;
  margin-bottom:12px;
}

/* =========================
RESPONSIVE
========================= */

@media(max-width:900px){

  .grid{
    grid-template-columns:1fr;
  }

}

</style>

</head>

<body>

<div class="container">

  <!-- HEADER -->
  <div class="topbar">

    <h1>📊 Dashboard PRO 6</h1>

    <div class="actions">

      <a href="/export/excel">
        <button>📥 Excel</button>
      </a>

      <a href="/export/pdf">
        <button>📄 PDF</button>
      </a>

      <a href="/campanas">
        <button class="campBtn">
          📲 Campañas
        </button>
      </a>

    </div>

  </div>

  <!-- FILTROS -->
  <form method="GET" action="/dashboard" class="filters">

    <input
      type="text"
      name="barrio"
      placeholder="Barrio"
    >

    <input
      type="date"
      name="fecha"
    >

    <input
      type="text"
      name="lider"
      placeholder="Líder"
    >

    <button type="submit">
      🔎 Filtrar
    </button>

  </form>

  <!-- KPIS -->
  <div class="kpis">

    <div class="kpi">
      <h2 id="simCount">
        <%= totalSimpatizantes || 0 %>
      </h2>

      <p>👥 Simpatizantes</p>
    </div>

    <div class="kpi">
      <h2 id="volCount">
        <%= totalVoluntarios || 0 %>
      </h2>

      <p>🧑‍🤝‍🧑 Voluntarios</p>
    </div>

  </div>

  <!-- CHARTS -->
  <div class="grid">

    <div class="box">

      <h3>📈 Voluntarios</h3>

      <canvas id="volChart"></canvas>

    </div>

    <div class="box">

      <h3>📈 Simpatizantes</h3>

      <canvas id="simChart"></canvas>

    </div>

  </div>

  <!-- ACTIVIDAD -->
  <div class="feed">

    <h3>🕒 Actividad reciente</h3>

    <% (actividad || []).forEach(a => { %>

      <div class="item">

        👤 <b><%= a.nombre %></b><br>

        📍 <%= a.barrio || 'Sin barrio' %><br>

        🕒 <%= a.fecha %>

      </div>

    <% }) %>

  </div>

</div>

<!-- =========================
CHART JS
========================= -->

<script>
const volLabels = volDias.map(v => v.fecha)
const volData = volDias.map(v => v.cantidad)

const simLabels = simDias.map(s => s.fecha)
const simData = simDias.map(s => s.cantidad)


/* VOLUNTARIOS */

new Chart(document.getElementById('volChart'), {

  type:'line',

  data:{
    labels: volLabels,

    datasets:[{
      label:'Voluntarios',
      data: volData,
      borderColor:'#38bdf8',
      backgroundColor:'rgba(56,189,248,0.15)',
      tension:0.4,
      fill:true
    }]
  }

})

/* SIMPATIZANTES */

new Chart(document.getElementById('simChart'), {

  type:'line',

  data:{
    labels: simLabels,

    datasets:[{
      label:'Simpatizantes',
      data: simData,
      borderColor:'#22c55e',
      backgroundColor:'rgba(34,197,94,0.15)',
      tension:0.4,
      fill:true
    }]
  }

})

</script>

<!-- =========================
SOCKET REALTIME
========================= -->

<script src="/socket.io/socket.io.js"></script>

<script>

const socket = io()

socket.on('updateDashboard', () => {

  fetch('/api/stats')

    .then(r => r.json())

    .then(data => {

      document.getElementById('volCount').innerText =
        data.voluntarios

      document.getElementById('simCount').innerText =
        data.simpatizantes

    })

})

</script>

</body>
</html>